{
  "name": "nbe-theta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4200",
    "dev:worker": "tsx watch worker/index.ts",
    "dev:all": "concurrently -n web,worker -c cyan,yellow \"pnpm dev\" \"pnpm dev:worker\"",
    "build": "next build",
    "start": "next start -p 4200",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contracts:generate": "pnpm --filter @nbe-theta/contracts generate",
    "contracts:check": "pnpm --filter @nbe-theta/contracts check",
    "test:watch": "vitest",
    "backtest": "tsx scripts/backtest.ts",
    "paper": "cross-env COINBASE_MODE=paper tsx worker/index.ts",
    "fetch-history": "tsx scripts/fetch-history.ts",
    "preflight": "tsx scripts/preflight.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@supabase/supabase-js": "^2.103.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^17.4.2",
    "ioredis": "^5.10.1",
    "jose": "^5.9.6",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "next": "16.2.3",
    "next-themes": "^0.4.6",
    "p-queue": "^8.0.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.10.0",
    "react-use-measure": "^2.1.7",
    "recharts": "^3.8.0",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0",
      "vite": ">=6.4.2",
      "hono": ">=4.12.14",
      "postcss": ">=8.5.10"
    }
  }
}
