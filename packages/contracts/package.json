{
  "name": "@nbe-theta/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Runtime-validated durable-payload contracts for NBE-Theta. Types generated from Pydantic JSON Schemas; ajv validators keyed by $id.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "generate:schemas": "uv run --frozen python -m nbe_theta_contracts.export schemas ./schemas",
    "generate:ts": "node scripts/generate-ts.mjs",
    "generate": "pnpm generate:schemas && pnpm generate:ts",
    "check": "pnpm generate && git diff --exit-code -- schemas generated",
    "test": "vitest run",
    "test:py": "uv run --frozen --extra dev pytest tests/python"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "json-schema-to-typescript": "^15.0.3",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
