{
  "$defs": {
    "Outcome": {
      "additionalProperties": false,
      "description": "A row from a market's outcomes table.",
      "properties": {
        "outcome_index": {
          "minimum": 0,
          "title": "Outcome Index",
          "type": "integer"
        },
        "outcome_name": {
          "minLength": 1,
          "title": "Outcome Name",
          "type": "string"
        },
        "outcome_token_id": {
          "minLength": 1,
          "title": "Outcome Token Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "description": "Schema version of this payload; consumers reject on mismatch.",
          "pattern": "^1\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "venue": {
          "const": "polymarket",
          "title": "Venue",
          "type": "string"
        },
        "venue_market_id": {
          "minLength": 1,
          "title": "Venue Market Id",
          "type": "string"
        }
      },
      "required": [
        "venue",
        "venue_market_id",
        "outcome_index",
        "outcome_name",
        "outcome_token_id"
      ],
      "title": "Outcome",
      "type": "object"
    }
  },
  "$id": "https://nbe-theta.local/schemas/market.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A single market on a venue.",
  "properties": {
    "active": {
      "title": "Active",
      "type": "boolean"
    },
    "closed": {
      "title": "Closed",
      "type": "boolean"
    },
    "closes_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Closes At"
    },
    "condition_id": {
      "minLength": 1,
      "title": "Condition Id",
      "type": "string"
    },
    "current_rule_version_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Rule Version Id"
    },
    "neg_risk": {
      "default": false,
      "title": "Neg Risk",
      "type": "boolean"
    },
    "opened_at": {
      "format": "date-time",
      "title": "Opened At",
      "type": "string"
    },
    "outcomes": {
      "items": {
        "$ref": "#/$defs/Outcome"
      },
      "title": "Outcomes",
      "type": "array"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "resolution_source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolution Source"
    },
    "resolved": {
      "title": "Resolved",
      "type": "boolean"
    },
    "resolved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved At"
    },
    "schema_version": {
      "default": "1.0.0",
      "description": "Schema version of this payload; consumers reject on mismatch.",
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "venue": {
      "const": "polymarket",
      "title": "Venue",
      "type": "string"
    },
    "venue_event_id": {
      "minLength": 1,
      "title": "Venue Event Id",
      "type": "string"
    },
    "venue_market_id": {
      "minLength": 1,
      "title": "Venue Market Id",
      "type": "string"
    }
  },
  "required": [
    "venue",
    "venue_market_id",
    "venue_event_id",
    "condition_id",
    "question",
    "active",
    "closed",
    "resolved",
    "opened_at"
  ],
  "title": "Market",
  "type": "object"
}
