{
  "$defs": {
    "OutcomeInstrument": {
      "additionalProperties": false,
      "description": "A tradable outcome token on a venue.\n\nUsed everywhere the executor / signal side needs to identify a\nspecific YES/NO share. ``condition_id`` selects the market;\n``outcome_token_id`` selects the side of it.",
      "properties": {
        "condition_id": {
          "minLength": 1,
          "title": "Condition Id",
          "type": "string"
        },
        "outcome_token_id": {
          "minLength": 1,
          "title": "Outcome Token Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "description": "Schema version of this payload; consumers reject on mismatch.",
          "title": "Schema Version",
          "type": "string"
        },
        "venue": {
          "const": "polymarket",
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "venue",
        "condition_id",
        "outcome_token_id"
      ],
      "title": "OutcomeInstrument",
      "type": "object"
    }
  },
  "$id": "https://nbe-theta.local/schemas/venue-order.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Executor-side snapshot of an order as we currently believe it.",
  "properties": {
    "account_id": {
      "minLength": 1,
      "title": "Account Id",
      "type": "string"
    },
    "client_intent_id": {
      "format": "uuid",
      "title": "Client Intent Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "fees_paid": {
      "default": "0",
      "format": "decimal",
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "title": "Fees Paid",
      "type": "string"
    },
    "filled_quantity": {
      "default": "0",
      "format": "decimal",
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "title": "Filled Quantity",
      "type": "string"
    },
    "instrument": {
      "$ref": "#/$defs/OutcomeInstrument"
    },
    "limit_price": {
      "format": "decimal",
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "title": "Limit Price",
      "type": "string"
    },
    "quantity": {
      "format": "decimal",
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "title": "Quantity",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "description": "Schema version of this payload; consumers reject on mismatch.",
      "title": "Schema Version",
      "type": "string"
    },
    "side": {
      "enum": [
        "BUY",
        "SELL"
      ],
      "title": "Side",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "signed",
        "submitted",
        "live",
        "partially_filled",
        "cancel_pending",
        "canceled",
        "filled",
        "rejected",
        "expired"
      ],
      "title": "Status",
      "type": "string"
    },
    "time_in_force": {
      "enum": [
        "GTC",
        "GTD",
        "FOK",
        "FAK"
      ],
      "title": "Time In Force",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "venue": {
      "const": "polymarket",
      "title": "Venue",
      "type": "string"
    },
    "venue_order_id": {
      "minLength": 1,
      "title": "Venue Order Id",
      "type": "string"
    }
  },
  "required": [
    "venue_order_id",
    "client_intent_id",
    "venue",
    "account_id",
    "instrument",
    "side",
    "quantity",
    "limit_price",
    "time_in_force",
    "status",
    "created_at",
    "updated_at"
  ],
  "title": "VenueOrder",
  "type": "object"
}
