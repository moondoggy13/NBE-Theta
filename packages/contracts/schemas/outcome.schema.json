{
  "$id": "https://nbe-theta.local/schemas/outcome.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A row from a market's outcomes table.",
  "properties": {
    "outcome_index": {
      "minimum": 0,
      "title": "Outcome Index",
      "type": "integer"
    },
    "outcome_name": {
      "minLength": 1,
      "title": "Outcome Name",
      "type": "string"
    },
    "outcome_token_id": {
      "minLength": 1,
      "title": "Outcome Token Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "description": "Schema version of this payload; consumers reject on mismatch.",
      "title": "Schema Version",
      "type": "string"
    },
    "venue": {
      "const": "polymarket",
      "title": "Venue",
      "type": "string"
    },
    "venue_market_id": {
      "minLength": 1,
      "title": "Venue Market Id",
      "type": "string"
    }
  },
  "required": [
    "venue",
    "venue_market_id",
    "outcome_index",
    "outcome_name",
    "outcome_token_id"
  ],
  "title": "Outcome",
  "type": "object"
}
