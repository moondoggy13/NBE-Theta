# Example env for the local Docker Compose stack. Copy to `.env` and fill.
# Never commit a filled `.env`.

# ── Postgres (db service) ──────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nbe_theta

# ── Web dashboard / control API ────────────────────────────────────
# Shared token required to POST to /api/kill-switch (and other control
# routes as they land). Replace with a strong random string.
# Generate one with: openssl rand -hex 32
CONTROL_API_TOKEN=

# Optional: point the dashboard at a hosted Supabase project instead of
# the local Postgres. Leave blank for local-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Execution ─────────────────────────────────────────────────────
# Three-flag gate for live CLOB orders. All THREE must be true or the
# venue adapter refuses to instantiate. Leave unset (or set to false/NO)
# for paper-only development.
EXECUTION_PROVIDER=mock
POLYMARKET_LIVE=false
CONFIRM_LIVE=NO

# Populated only inside the executor container at runtime. Never here.
# SIGNER_PRIVATE_KEY=
# PROXY_ADDRESS=
# POLYMARKET_FUNDER_ADDRESS=

# ── Chain access (Intelligence + Executor) ────────────────────────
# POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/...
# POLYGON_WS_URL=wss://polygon-mainnet.g.alchemy.com/v2/...

# ── Observability ─────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development
