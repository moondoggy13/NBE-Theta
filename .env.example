# Example env for the local Docker Compose stack. Copy to `.env` and fill.
# Never commit a filled `.env`.

# ── Postgres (db service) ──────────────────────────────────────────
# Only the password is configurable. POSTGRES_USER/POSTGRES_DB must NOT
# be overridden on the supabase/postgres image — its bundled init
# bootstraps as `supabase_admin` and breaks if the user is changed.
POSTGRES_PASSWORD=postgres

# Host-side connection URL for `pnpm migrate up|status` and the smoke
# suite. supabase_admin is the image's superuser (and owns the
# supabase_realtime publication our migrations alter). Note the port:
# docker-compose maps the db to 54322 on the host.
DATABASE_URL=postgres://supabase_admin:postgres@localhost:54322/postgres

# ── Web dashboard / control API ────────────────────────────────────
# Shared operator bearer token. This gates FAR more than the kill
# switch: since PR 9 it protects every route that reads an RLS
# deny-list table with the service-role key — /api/console/* (signals,
# cohort, portfolio, health, mode, gate), /api/smart-money/*, and both
# verbs of /api/watchlist. Those rows are the thesis, not just a
# switch. See src/lib/auth.ts.
#
# Minimum 16 characters; shorter (or unset) fails CLOSED in production,
# refusing every gated request with 503 rather than serving them.
#
# Generate one with: openssl rand -hex 32
# To rotate: docs/runbooks/rotate-control-api-token.md
#
# TRANSITIONAL. PR 12 (ADR-0004) added per-operator Supabase identity
# with roles; this token remains as a fallback so the switch is not
# all-at-once. It is capped at the 'operator' role and therefore cannot
# arm live trading. Prefer real accounts: docs/runbooks/manage-operators.md
CONTROL_API_TOKEN=

# Role granted to a caller presenting the shared token above. Defaults to
# 'operator'. Setting 'admin' lets an unnamed shared credential arm live
# trading, which is exactly what ADR-0004 exists to prevent — do not,
# outside a test.
CONTROL_API_TOKEN_ROLE=

# Optional: point the dashboard at a hosted Supabase project instead of
# the local Postgres. Leave blank for local-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Execution ─────────────────────────────────────────────────────
# Three-flag gate for live CLOB orders. All THREE must be true or the
# venue adapter refuses to instantiate. Leave unset (or set to false/NO)
# for paper-only development.
EXECUTION_PROVIDER=mock
POLYMARKET_LIVE=false
CONFIRM_LIVE=NO

# Populated only inside the executor container at runtime. Never here.
# SIGNER_PRIVATE_KEY=
# PROXY_ADDRESS=
# POLYMARKET_FUNDER_ADDRESS=

# ── Chain access (Intelligence + Executor) ────────────────────────
# POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/...
# POLYGON_WS_URL=wss://polygon-mainnet.g.alchemy.com/v2/...

# ── Wallet live monitor (theta-live-monitor) ──────────────────────
# All optional; defaults shown. Tick cadence plus the per-phase refresh
# intervals for positions and the leaderboard sweep.
# MONITOR_INTERVAL_S=30
# SYNC_OVERLAP_S=120
# SYNC_MAX_PAGES=5
# POSITIONS_REFRESH_S=300
# LEADERBOARD_REFRESH_S=3600

# ── CLOB market data (theta-market-data) ──────────────────────────
# All optional; defaults shown. The collector streams the order book for
# watchlisted markets and REST-resyncs after any gap.
# CLOB_BASE_URL=https://clob.polymarket.com
# CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# CLOB_TIMEOUT_S=30
# MARKET_CYCLE_S=15
# MARKET_MAX_MESSAGES=500
# Minimum gap between persisted quotes per token. A busy book updates far
# faster than any consumer reads it.
# MARKET_MIN_QUOTE_INTERVAL_S=1
# MARKET_STALE_AFTER_S=120
# Subscription cap for one process; a bigger watchlist needs sharding.
# MARKET_MAX_TOKENS=200

# ── Observability ─────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development
