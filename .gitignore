# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored: pnpm workspaces put a node_modules (with symlinks back into
# packages/) under every app and package, not just the root. The old
# `/node_modules` only matched the root one, which is how a workspace
# symlink got committed in #14. This subsumes the `apps/*/node_modules`
# and `packages/*/node_modules` globs this branch had added — those only
# covered one level of nesting each.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase CLI cache / local build artifacts
/supabase/.temp
/supabase/.branches
/python/.venv
/python/__pycache__
**/__pycache__
*.pyc
/data

# typescript
*.tsbuildinfo
next-env.d.ts

# Python worker raw-response archive (local FS)
/python/data/
